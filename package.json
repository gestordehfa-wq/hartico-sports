{
  "name": "hartico-sports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:racing": "npm run dev -w @hartico/racing",
    "dev:football-lite": "npm run dev -w @hartico/football-lite",
    "dev:tennis": "npm run dev -w @hartico/tennis",
    "supabase:assemble": "node tooling/assemble-supabase.mjs --write",
    "supabase:check": "node tooling/assemble-supabase.mjs --check",
    "supabase:start": "supabase start --workdir .",
    "supabase:reset": "npm run supabase:assemble && supabase db reset --local --workdir .",
    "supabase:test": "supabase test db --local --workdir .",
    "supabase:status": "supabase status --workdir .",
    "supabase:stop": "supabase stop --workdir .",
    "supabase:link": "supabase link --workdir .",
    "supabase:push:dry-run": "npm run supabase:check && supabase db push --linked --dry-run --workdir .",
    "supabase:push": "npm run supabase:check && supabase db push --linked --workdir .",
    "supabase:test:cloud": "supabase test db --linked --workdir .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome lint .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run supabase:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
